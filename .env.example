# ── Firebase web app (Firebase console → Project settings → Your apps) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# ── Server-only (Vercel / hosting env; never exposed to the browser) ──
GEMINI_API_KEY=
# Used by /api/ai/generate to verify the caller's Firebase ID token. Same value as VITE_FIREBASE_API_KEY.
FIREBASE_API_KEY=

# ── Optional: development-only 1-click demo login (leave unset / false in production) ──
VITE_ENABLE_DEMO_LOGIN=false
VITE_DEMO_STUDENT_EMAIL=
VITE_DEMO_STUDENT_PASSWORD=
VITE_DEMO_TUTOR_EMAIL=
VITE_DEMO_TUTOR_PASSWORD=

# ── Legacy (unused by the app now; safe to delete along with src/integrations/supabase) ──
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
